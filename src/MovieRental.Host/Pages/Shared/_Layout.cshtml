@{
    // The layout reads the page's own strongly-typed model — no ViewData round trip.
    var view = ((AppPageModel)Model).View;
}
<!DOCTYPE html>
<html lang="en" class="rr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@view.Title</title>
    <meta name="description" content="@view.Tagline" />
    <meta name="color-scheme" content="dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    @if (view.Assets.StyleUrl is { } styleUrl)
    {
        <link rel="stylesheet" href="@styleUrl" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
</head>
<body class="rr-body">
    <a class="rr-skip" href="#main">Skip to content</a>

    <header class="rr-header">
        <a class="rr-wordmark" href="/" aria-label="Reel and Row home">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10.2" fill="none" stroke="currentColor" stroke-width="1.3" />
                <circle cx="12" cy="12" r="2.6" fill="currentColor" />
                <circle cx="12" cy="5.6" r="2" fill="currentColor" opacity=".75" />
                <circle cx="12" cy="18.4" r="2" fill="currentColor" opacity=".75" />
                <circle cx="5.6" cy="12" r="2" fill="currentColor" opacity=".75" />
                <circle cx="18.4" cy="12" r="2" fill="currentColor" opacity=".75" />
            </svg>
            <span>Reel &amp; Row</span>
        </a>

        <nav class="rr-nav" aria-label="Main">
            <a href="/" class="@(view.ActiveNav == "home" ? "is-current" : null)">Catalogue</a>
            <a href="/cinema" class="@(view.ActiveNav == "cinema" ? "is-current" : null)">Cinema seats</a>
            <a href="/rentals" class="@(view.ActiveNav == "rentals" ? "is-current" : null)">My rentals</a>
            <a href="/studio" class="@(view.ActiveNav == "studio" ? "is-current" : null)">Studio</a>
            <a href="/admin" class="@(view.ActiveNav == "admin" ? "is-current" : null)">Admin</a>
        </nav>

        <a class="rr-account" href="/account">Sign in</a>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="rr-footer">
        <p>Reel &amp; Row — a teaching build. Data resets whenever you drop the database.</p>
        <a href="/swagger">API reference</a>
    </footer>

    @* The React island. Everything dynamic lives inside this root; Razor stays the shell. *@
    @if (view.Assets.ViteClientUrl is { } viteClient)
    {
        <script type="module" src="@viteClient"></script>
    }
    @if (view.Assets.UseDevServer)
    {
        <script type="module" src="@view.Assets.ScriptUrl"></script>
    }
    else
    {
        <script type="module" src="@view.Assets.ScriptUrl" asp-append-version="true"></script>
    }
</body>
</html>
